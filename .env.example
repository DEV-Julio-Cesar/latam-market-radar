# Node 24+; todos os valores abaixo são locais. Nunca use senha de demonstração em produção.
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/radar.sqlite
APP_ORIGIN=http://127.0.0.1:3001
COOKIE_SECURE=false
SESSION_HOURS=24
DEMO_EMAIL=demo@radar.local
DEMO_PASSWORD=RadarDemo!2026
# Desativado por padrão. Envio ocorre somente ao registrar novas observações.
NOTIFICATIONS_ENABLED=false
# Apenas alertas deste usuário são enviados aos destinos globais abaixo.
NOTIFICATION_OWNER_EMAIL=demo@radar.local
DISCORD_WEBHOOK_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT=
WHATSAPP_API_VERSION=v23.0
# Template aprovado com 1 parâmetro de texto no corpo: a mensagem do alerta.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# PostgreSQL externo em hospedagem. Vazio mantém SQLite local. Nunca publique a URL real.
DATABASE_URL=
